// Cloudflare deployment of Phyein Usul (https://phyeinusul.com). See docs/usul.md.
// Static files only: `npm run build` writes dist/, and `npx wrangler deploy` publishes it. Cloudflare Workers Builds runs both
// on every push or merge to main (since 21 October 2026), so merging into main deploys.
{
  "name": "phyein-usul",
  "compatibility_date": "2026-10-06",
  // "html_handling": "none" (31 October 2026, Numa's decision): x.html is served at once, without the 307 to x that cost a round
  // trip on every click; the short addresses keep working through public/_redirects (tools/redirects.py). See docs/performance.md.
  "assets": { "directory": "./dist", "html_handling": "none" },
  "workers_dev": true,
  "routes": [
    { "pattern": "phyeinusul.com", "custom_domain": true },
    { "pattern": "www.phyeinusul.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
