FoamFile { format ascii; class volScalarField; object p_rgh; }
dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    glass       { type fixedFluxPressure; }
    // open air: the pressure above its hydrostatic part (p_rgh) is held at 0, so still air stays still. Fixing the static
    // pressure instead made the spill ring (at the rim) and the top (25 mm higher) disagree by rho_air g dz = 0.29 Pa,
    // which drove a draft of about 0.7 m/s past the rim (measured) and set the time step
    spill       { type totalPressure; p0 uniform 0; }
    atmosphere  { type totalPressure; p0 uniform 0; }
}
